{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Configure Debug",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Configure Release",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Release"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Release"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Configure Release",
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
